<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^products/?$ products.php [L,QSA]
    RewriteRule ^categories/?$ categories.php [L,QSA]
    RewriteRule ^suppliers/?$ suppliers.php [L,QSA]
    RewriteRule ^inventory/?$ inventory.php [L,QSA]
    RewriteRule ^movements/?$ movements.php [L,QSA]
    RewriteRule ^reports/?$ reports.php [L,QSA]
    RewriteRule ^external/cep/?$ external/cep.php [L,QSA]
    RewriteRule ^external/cnpj/?$ external/cnpj.php [L,QSA]
</IfModule>
